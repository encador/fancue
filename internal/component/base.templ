package component

templ Buttons() {
	<div
		id="box"
		data-init="$toggle=false"
	>
		<button type="button" data-attr:disabled="$toggle" data-on:click="$toggle = !$toggle" class="red">Click Me</button>
		<button type="button" class="blue">o_o</button>
		<button type="button" data-attr:disabled="!$toggle" data-on:click="$toggle = !$toggle" class="green">Click Me</button>
	</div>
	<style>
		#box {
			width: 65vw;
			height: 70vh;
			background-color: var(--primary);
			border: 3px solid var(--border);
			display: flex;
			gap: 10px;
			flex-direction: column;
			justify-content: center;
			align-items: center;
		}
	</style>
}

templ Base(content ...templ.Component) {
	<!DOCTYPE html>
	<html>
		<head>
			@BaseCSS()
			<script type="module" src="/static/datastar.js"></script>
		</head>
		<body>
			for _, c := range content {
				@c
			}
		</body>
	</html>
}

templ BaseCSS() {
	@ColorCSS()
	@ButtonCSS()
	@InputCSS()
	<style>
		* {
			padding: 0;
			margin: 0;
			box-sizing: border-box;
			user-select: none;
			-webkit-user-select: none;
		}

		body {
			background-color: var(--bg);
			min-height: 100vh;
			width: 100%;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
		}
	</style>
}

templ ColorCSS() {
	<style>
		:root {
			--beige: #fff8eb;
			--beige-2: #fff1d6;
			--beige-blue: #f8f5e6;
			--blue: #c5e1fc;
			--blue-2: #77baf8;
			--blue-3: #08549b;
			--black: black;
			--red: #f29195;
			--red-2: #ec5b60;
			--red-3: #6e0d10;
			--green: #9fd1a9;
			--green-2: #75bd84;
			--green-3: #3c7c49;
			--orange: #ffe9d6;
			--orange-2: #ffd3ad;
			--orange-3: #7a3900;

			--bg: var(--beige-2);
			--border: var(--black);
			--primary: var(--beige-blue);
		}
	</style>
}

templ InputCSS() {
	<style>
		input {
			all: unset;
			border: 0.2rem solid var(--orange-3);
			box-shadow: 0.2rem 0.2rem var(--orange-3);
			background-color: var(--orange);
			color: var(--orange-3);
			font-weight: bold;
			font-size: 1.2rem;
			padding: 0.15rem;
			text-align: center;
			margin: 0.3rem;
			margin-top: 0;
		}
		input:hover:not(:disabled) {
			cursor: text;
			background-color: var(--orange-2);
		}
		input:focus:not(:disabled) {
			background-color: var(--orange-2);
			transform: translate(0.2rem, 0.2rem);
			box-shadow: none;
		}
		input:disabled {
			cursor: default;
			transform: translate(0.2rem, 0.2rem);
			box-shadow: none;
			opacity: 0.5;
		}
	</style>
}

templ ButtonCSS() {
	<style>
		button {
			/*font-size: clamp(1rem, 1vw, 1.5rem);*/
			font-size: 1.5rem;
			font-weight: bold;
			padding: 0.3rem 0.6rem 0.3rem 0.6rem;
			border: 0.2rem solid;
			cursor: pointer;
			box-shadow: 0.25rem 0.25rem;
			height: fit-content;
		}
		button:hover {
			transform: translate(0.05rem, 0.05rem);
			box-shadow: 0.2rem 0.2rem;
		}
		button:active {
			transform: translate(0.25rem, 0.25rem);
			box-shadow: none;
		}
		button:disabled {
			opacity: 0.6;
			transform: translate(0.25rem, 0.25rem);
			box-shadow: none;
			transition: none;
			cursor: default;
		}
		button.red {
			color: var(--red-3);
			background-color: var(--red);
		}
		button.red:hover:not(:disabled) {
			background-color: var(--red-2);
		}
		button.green {
			color: var(--green-3);
			background-color: var(--green);
		}
		button.green:hover:not(:disabled) {
			background-color: var(--green-2);
		}
		button.blue {
			color: var(--blue-3);
			background-color: var(--blue);
		}
		button.blue:hover:not(:disabled) {
			background-color: var(--blue-2);
		}
	</style>
}
