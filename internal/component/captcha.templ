package component

import "strconv"

templ Captcha(icons []string, target, secret string) {
	@CaptchaCSS()
	<div
		id="captcha"
		data-init="$selection = []"
	>
		<span id="captcha-prompt">Select all: { target }</span>
		<div id="captcha-box">
			for i := range(len(icons)) {
				<button
					class="blue"
					data-attr:disabled={ "$selection.includes(" + strconv.Itoa(i) + ")" }
					data-on:click={ "$selection.push(" + strconv.Itoa(i) + ")" }
				>{ icons[i] }</button>
			}
		</div>
		<button
			id="captcha-reset"
			type="button"
			class="red"
			data-on:click="$selection.length=0"
			data-show="$selection.length !== 0"
		>reset</button>
	</div>
}

templ CaptchaCSS() {
	<style>
		#captcha {
			max-width: 90%;
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: center;
			border: 0.2rem solid var(--border);
			background-color: var(--beige);
			/*padding-top: 0.5rem;*/
		}
		#captcha-reset {
			position: absolute;
			top: -1.5rem;
			right: -1rem;
			font-size: 1rem;
			rotate: 5deg;
		}

		#captcha-prompt {
			position: absolute;
			font-size: 1.5rem;
			top: -1.8rem;
			left: -2.5rem;
			rotate: -3deg;
			border: 0.22rem solid black;
			border-radius: 5px;
			/*box-shadow: 0.1rem 0.1rem var(--border);*/
			padding: 0 0.5rem 0 0.5rem;
			width: fit-content;
			background-color: var(--beige);
			color: var(--red-3);
			font-weight: bold;
			text-align: center;
		}
		#captcha-box {
			padding: 1rem;
			display: flex;
			flex-direction: row;
			width: 100%;
			justify-content: center;
			align-items: center;
			overflow: auto;
			flex-wrap: wrap;
			gap: 0.8rem;
		}

		#captcha-box button {
			padding: 0 1rem 0 1rem;
		}
	</style>
}
