package component

templ RegisterForm() {
	@RegisterFormCSS()
	<form
		id="register-form"
	>
		<span id="register-form-title">Register</span>
		<label for="form-username">Username</label>
		<input id="form-username" data-bind="username" type="text"/>
		<label for="form-password">Password</label>
		<input
			id="form-password"
			data-bind="password"
			type="password"
		/>
		<label for="form-password-repeat" data-style:color="($password !== $password2) && 'var(--red-2)'">Repeat Password</label>
		<input
			id="form-password-repeat"
			data-bind="password2"
			type="password"
		/>
		<button
			type="button"
			class="green"
			id="register-form-submit"
			data-attr:disabled="$username === '' || $password === '' || $password !== $password2 || $requesting"
			data-on:click="@post('/register')"
			data-indicator="requesting"
		>Submit</button>
	</form>
}

templ RegisterFormCSS() {
	<style>
		#register-form {
			position: relative;
			width: fit-content;
			padding: 1rem;
			padding-bottom: 2rem;
			border: 0.2rem solid var(--border);
			background-color: var(--beige);
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			/*gap: 1rem;*/
			margin: 1.5rem;
		}
		#register-form label {
			font-size: 1.4rem;
			font-weight: bold;
			color: var(--red-3);
		}
		#register-form-title {
			position: absolute;
			bottom: calc(100% - 1rem);
			left: -1.5rem;
			rotate: -5deg;
			padding: 0 1rem 0 1rem;
			background-color: var(--beige);
			border: 0.2rem solid var(--border);
			font-weight: bold;
			font-size: 1.5rem;
		}
		#register-form-submit {
			position: absolute;
			top: calc(100% - 1.5rem);
			padding-right: 1rem;
			padding-left: 1rem;
		}
	</style>
}
