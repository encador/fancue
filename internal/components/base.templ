package components

templ Base() {
	<!DOCTYPE html>
	<html>
		<head>
			@BaseCSS()
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.2/bundles/datastar.js"></script>
		</head>
		<body>
			<div
				id="box"
				data-init="$toggle=false"
			>
				<button type="button" data-attr:disabled="$toggle" data-on:click="$toggle = !$toggle" class="red">Click Me</button>
				<button type="button" data-attr:disabled="!$toggle" data-on:click="$toggle = !$toggle" class="green">Click Me</button>
			</div>
		</body>
	</html>
}

templ BaseCSS() {
	<style>
		* {
			padding: 0;
			margin: 0;
			box-sizing: border-box;
			user-select: none;
			-webkit-user-select: none;
		}

		:root {
			--beige: #fff8eb;
			--beige-2: #fff1d6;
			--beige-blue: #f8f5e6;
			--blue: #f1f8f8;
			--blue-2: #e4f1f2;
			--black: black;
			--red: #f29195;
			--red-2: #ec5b60;
			--red-3: #6e0d10;
			--green: #9fd1a9;
			--green-2: #75bd84;
			--green-3: #3c7c49;

			--bg: var(--beige-2);
			--border: var(--black);
			--primary: var(--beige-blue);
		}

		button {
			/*font-size: clamp(1rem, 1vw, 1.5rem);*/
			font-size: 1.5rem;
			font-weight: bold;
			padding: 5px 10px 5px 10px;
			border: 3px solid;
			cursor: pointer;
			box-shadow: 4px 4px;
			/*transition:
				transform 0.05s ease,
				box-shadow 0.05s ease;*/
		}
		button:hover {
			transform: translate(1px, 1px);
			box-shadow: 3px 3px;
		}
		button:active {
			transform: translate(4px, 4px);
			box-shadow: none;
		}
		button:disabled {
			opacity: 0.6;
			transform: none;
			box-shadow: 2px 2px;
			transition: none;
			cursor: default;
			transform: none;
		}
		button.red {
			color: var(--red-3);
			background-color: var(--red);
		}
		button.red:hover:not(:disabled) {
			background-color: var(--red-2);
		}
		button.green {
			color: var(--green-3);
			background-color: var(--green);
		}
		button.green:hover:not(:disabled) {
			background-color: var(--green-2);
		}

		body {
			background-color: var(--bg);
			min-height: 100vh;
			width: 100%;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
		}

		#box {
			width: 65vw;
			height: 70vh;
			background-color: var(--primary);
			border: 4px solid var(--border);
			display: flex;
			gap: 10px;
			flex-direction: column;
			justify-content: center;
			align-items: center;
		}
	</style>
}
